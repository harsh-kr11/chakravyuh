# Copy this file to .env and fill in only what you need.
# .env is git-ignored — never commit real keys.
#
# The core pipeline (demo, API, dashboard, tests) runs with ZERO of this
# configured. Everything below is optional, additive capability.

# --- Analyst Copilot (optional) --------------------------------------------
# Read-only, RAG-grounded incident narrative. Never in the containment
# decision path. Pick one provider and set its key.
CHAKRAVYUH_LLM_PROVIDER=gemini        # none | anthropic | openai | gemini
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# CHAKRAVYUH_LLM_MODEL=                # optional override; each provider has a sensible default

# --- Knowledge graph (optional — falls back to an offline lookup) ---------
CHAKRAVYUH_NEO4J_URI=bolt://localhost:7687
CHAKRAVYUH_NEO4J_USER=neo4j
CHAKRAVYUH_NEO4J_PASSWORD=chakravyuh_dev

# --- Detection / interdiction policy ---------------------------------------
CHAKRAVYUH_ANOMALY_THRESHOLD=0.5
CHAKRAVYUH_BLAST_RADIUS=5.0

# --- API ---------------------------------------------------------------
CHAKRAVYUH_API_HOST=127.0.0.1
CHAKRAVYUH_API_PORT=8080

# --- Persistence ------------------------------------------------------------
CHAKRAVYUH_DB_PATH=data/chakravyuh.db
